{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aptisesol-production.up.railway.app/api/:path*"
    },
    {
      "source": "/oauth2/authorization/:path*",
      "destination": "https://aptisesol-production.up.railway.app/oauth2/authorization/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://aptisesol-production.up.railway.app/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
